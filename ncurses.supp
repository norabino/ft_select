# Valgrind suppressions for ft_select
# Hides only the "still reachable" memory kept by ncurses/tinfo
# (allocated by tgetent/tgetstr, never freed by the library).
# Real leaks ("definitely lost") from your own code stay visible.

{
   tinfo_still_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:*/libtinfo.so*
   ...
}

{
   ncurses_still_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:*/libncurses*.so*
   ...
}

{
   tgetent_still_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:tgetent
   ...
}
